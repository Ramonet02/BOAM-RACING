# BOAM RACING — variables locales. NO se sube al repo (.gitignore: .env*.local).
# Explicacion de cada una en .env.example.

# ── Envio de solicitudes de patrocinio: Gmail del equipo ──────────────────
GMAIL_USER=boamracingteam@gmail.com
# Contrasena de APLICACION de Google (16 letras), no la de la cuenta.
GMAIL_APP_PASSWORD= ifws xxvd tcvr vkva

# Buzon que recibe las solicitudes. Vacio = GMAIL_USER.
SPONSOR_MAIL_TO=

# URL publica de la web, sin barra final (p. ej. https://boamracing.vercel.app).
# Se usa para el enlace al dossier en el correo de confirmacion al cliente.
# Vacia = el correo va sin enlace.
SITE_URL=
